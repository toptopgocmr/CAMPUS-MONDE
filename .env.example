# ===== Base MySQL =====
# Option 1 : une seule ligne (Railway : DATABASE_URL=${{MySQL.MYSQL_URL}})
# DATABASE_URL=mysql://utilisateur:motdepasse@hote:3306/campusmonde
# Option 2 : champ par champ (XAMPP par défaut : root sans mot de passe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusmonde
DB_USER=root
DB_PASSWORD=

APP_ENV=production
# Clé secrète pour signer les reçus (QR code). Obligatoire sur Railway, sinon les QR des anciens reçus deviennent invalides après un redéploiement.
# Exemple : une chaîne aléatoire de 64 caractères (openssl rand -hex 32)
APP_SECRET=
APP_URL=https://campusmonde.example

# Premier compte administrateur (créé automatiquement au premier lancement)
ADMIN_EMAIL=admin@votre-domaine.cg
ADMIN_PASSWORD=ChangezMoi2026

# ===== E-mails (codes de vérification, MFA, notifications) =====
# Sans SMTP, les e-mails sont écrits dans le journal du serveur (fenêtre noire en local).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@votre-domaine.cg
SMTP_PASS=motdepasse-smtp
MAIL_FROM="Campus Monde <no-reply@votre-domaine.cg>"

# ===== Optionnel =====
# true = crée les comptes de démonstration (mot de passe demo1234). À retirer en production.
SEED_DEMO=
# true = désactive le code MFA du back-office (déconseillé)
MFA_DISABLED=
# Dossier privé des documents déposés (par défaut storage/documents). Sur Railway : un volume, ex. /data/documents
STORAGE_DIR=
